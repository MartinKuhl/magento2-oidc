includes:
    - %rootDir%/../../bitexpert/phpstan-magento/extension.neon

parameters:
    phpVersion:
        min: 80200  # PHP 8.2
        max: 80500  # PHP 8.5
    level: 6
    # bitexpert/phpstan-magento's FactoryAutoloader caches each generated factory
    # stub's *source* under PHPStan\Cache\Cache and then does
    # require_once($cache->load(...)) expecting a file path back — but
    # Cache::load()/save() only ever round-trip the raw value, not a path. Under
    # PHPStan 2.2's parallel workers this occasionally surfaces as
    # "Failed opening required '<?php ...'" (the raw generated source getting
    # passed to require_once as if it were a filename) for any *Factory class
    # that isn't a real file — i.e. every Magento-generated factory, including
    # our own. Forcing single-process analysis avoids the race.
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - ..
    excludePaths:
        analyseAndScan:
            - ../vendor (?)
            - ../.github
            # Stub file defines minimal class skeletons for CI-only PHPUnit use;
            # scanning it would override PHPStan's real Magento type knowledge.
            - Stubs
        analyse:
            - psalm-stubs.stub
            - rector.php
            - phpstan-stubs.stub
    scanFiles:
        - psalm-stubs.stub
    stubFiles:
        # Overrides auto-generated FactoryAutoloader stubs for classes whose names
        # end with "Factory" but are NOT simple Magento DI factories.
        - phpstan-stubs.stub
    ignoreErrors:
        # The bitexpert/phpstan-magento FactoryAutoloader matches ANY class ending with
        # "Factory" and generates a minimal stub (only `create(array $data = [])`) for it.
        # CookieMetadataFactory, ResultFactory, and FileFactory are NOT simple DI factories —
        # they have custom signatures defined in Test/phpstan-stubs.stub. PHPStan 2.x loads
        # the stubs correctly (confirmed via dump-parameters) but the FactoryAutoloader's
        # generated stub still takes precedence in practice. The real methods exist in vendor.
        -
            message: '#Call to an undefined method Magento\\Framework\\Stdlib\\Cookie\\CookieMetadataFactory::(createPublicCookieMetadata|createCookieMetadata|createSensitiveCookieMetadata)\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        -
            message: '#Access to undefined constant Magento\\Framework\\Controller\\ResultFactory::TYPE_#'
            identifier: classConstant.notFound
            reportUnmatched: false
        -
            message: '#Method Magento\\Framework\\App\\Response\\Http\\FileFactory::create\(\) invoked with \d+ parameters?, \d+-?\d* required\.#'
            identifier: arguments.count
            reportUnmatched: false
        -
            message: '#Parameter \#1 \$data of method Magento\\Framework\\App\\Response\\Http\\FileFactory::create\(\) expects array, string given\.#'
            identifier: argument.type
            reportUnmatched: false
        -
            message: '#Call to an undefined method Magento\\Framework\\App\\RequestInterface::getClientIp\(\)\.#'
            identifier: method.notFound
        # Same FactoryAutoloader problem for our own RedisConnectionFactory: it is a
        # connection provider (memoized raw phpredis client), not a Magento DI factory,
        # but its name matches #Factory$# so the generated create()-only stub shadows
        # the real class (module classes are not composer-autoloadable during analysis).
        -
            message: '#Call to an undefined method M2Oidc\\OAuth\\Model\\Cache\\RedisConnectionFactory::getConnection\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        -
            message: '#Class M2Oidc\\OAuth\\Model\\Cache\\RedisConnectionFactory does not have a constructor and must be instantiated without any parameters\.#'
            identifier: new.noConstructor
            reportUnmatched: false
        # Same FactoryAutoloader problem for WebauthnCeremonyFactory: it is a factory
        # for webauthn-lib ceremony objects (serializer, RP entity, ceremony step
        # managers), not a Magento DI factory, but its name matches #Factory$# so the
        # generated create()-only stub shadows the real class's actual methods.
        -
            message: '#Call to an undefined method M2Oidc\\OAuth\\Model\\Passkey\\WebauthnCeremonyFactory::\w+\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        # Cm_Cache_Backend_Redis (colinmollenhour/cache-backend-redis) is an intentionally
        # optional runtime dependency for SlidingWindowStrategy's Redis-only fast path —
        # guarded by instanceof + try/catch with graceful degradation, not required by
        # this module's composer.json, so PHPStan can't resolve it in this analysis run.
        -
            message: '#Class Cm_Cache_Backend_Redis not found\.#'
            identifier: class.notFound
            reportUnmatched: false
