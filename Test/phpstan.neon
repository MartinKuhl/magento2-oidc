includes:
    - %rootDir%/../../bitexpert/phpstan-magento/extension.neon

parameters:
    phpVersion:
        min: 80200  # PHP 8.2
        max: 80500  # PHP 8.5
    level: 6
    # bitexpert/phpstan-magento's FactoryAutoloader caches each generated factory
    # stub's *source* under PHPStan\Cache\Cache and then does
    # require_once($cache->load(...)) expecting a file path back — but
    # Cache::load()/save() only ever round-trip the raw value, not a path. Under
    # PHPStan 2.2's parallel workers this occasionally surfaces as
    # "Failed opening required '<?php ...'" (the raw generated source getting
    # passed to require_once as if it were a filename) for any *Factory class
    # that isn't a real file — i.e. every Magento-generated factory, including
    # our own. Forcing single-process analysis avoids the race.
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - ..
    excludePaths:
        analyseAndScan:
            - ../vendor (?)
            - ../.github
            # Stub file defines minimal class skeletons for CI-only PHPUnit use;
            # scanning it would override PHPStan's real Magento type knowledge.
            - Stubs
        analyse:
            - psalm-stubs.stub
            - rector.php
            - phpstan-stubs.stub
            # bitexpert/phpstan-magento's ExtensionAutoloader/ExtensionInterfaceAutoloader
            # are registered globally via spl_autoload_register and pattern-match ANY class
            # ending in "Extension"/"ExtensionInterface" — not just Magento's own
            # extension-attribute classes — assuming Magento's generated-extension-attribute
            # naming convention applies. webauthn-lib's real class
            # Webauthn\AuthenticationExtensions\AuthenticationExtension (used internally by
            # PublicKeyCredentialRequestOptions, which this file calls) coincidentally
            # matches. Reflecting it makes ExtensionAutoloader derive a bogus
            # "...ExtensionInterface" name and reflect THAT without an existence guard,
            # which in turn trips ExtensionInterfaceAutoloader, which derives a second bogus
            # "...AuthenticationInterface" name, finds it genuinely doesn't exist, and
            # throws — aborting the whole PHPStan run as an uncatchable "Internal error"
            # (confirmed via a minimal repro calling only
            # Webauthn\PublicKeyCredentialRequestOptions::create(); reproduces even in
            # isolation, with no OIDC/passkey code involved). Not fixable from this repo:
            # both autoloaders' existence checks go through their own raw
            # Composer\Autoload\ClassLoader instance (DataProvider\ClassLoaderProvider), not
            # PHPStan's reflection provider, so nothing declared via stubFiles/scanFiles is
            # visible to them — and this is an uncaught "Internal error", which bypasses
            # ignoreErrors entirely (confirmed empirically, not just per docs). Excluding
            # only this one file from analysis (it remains scannable, so callers of its
            # public API are still type-checked correctly) is the only within-repo
            # mitigation; every other Passkey file keeps full PHPStan coverage.
            - ../Model/Passkey/PasskeyAuthenticationService.php
    scanFiles:
        - psalm-stubs.stub
    stubFiles:
        # Overrides auto-generated FactoryAutoloader stubs for classes whose names
        # end with "Factory" but are NOT simple Magento DI factories.
        - phpstan-stubs.stub
    ignoreErrors:
        # The bitexpert/phpstan-magento FactoryAutoloader matches ANY class ending with
        # "Factory" and generates a minimal stub (only `create(array $data = [])`) for it.
        # CookieMetadataFactory, ResultFactory, and FileFactory are NOT simple DI factories —
        # they have custom signatures defined in Test/phpstan-stubs.stub. PHPStan 2.x loads
        # the stubs correctly (confirmed via dump-parameters) but the FactoryAutoloader's
        # generated stub still takes precedence in practice. The real methods exist in vendor.
        -
            message: '#Call to an undefined method Magento\\Framework\\Stdlib\\Cookie\\CookieMetadataFactory::(createPublicCookieMetadata|createCookieMetadata|createSensitiveCookieMetadata)\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        -
            message: '#Access to undefined constant Magento\\Framework\\Controller\\ResultFactory::TYPE_#'
            identifier: classConstant.notFound
            reportUnmatched: false
        -
            message: '#Method Magento\\Framework\\App\\Response\\Http\\FileFactory::create\(\) invoked with \d+ parameters?, \d+-?\d* required\.#'
            identifier: arguments.count
            reportUnmatched: false
        -
            message: '#Parameter \#1 \$data of method Magento\\Framework\\App\\Response\\Http\\FileFactory::create\(\) expects array, string given\.#'
            identifier: argument.type
            reportUnmatched: false
        -
            message: '#Call to an undefined method Magento\\Framework\\App\\RequestInterface::getClientIp\(\)\.#'
            identifier: method.notFound
        # Same FactoryAutoloader problem for our own RedisConnectionFactory: it is a
        # connection provider (memoized raw phpredis client), not a Magento DI factory,
        # but its name matches #Factory$# so the generated create()-only stub shadows
        # the real class (module classes are not composer-autoloadable during analysis).
        -
            message: '#Call to an undefined method M2Oidc\\OAuth\\Model\\Cache\\RedisConnectionFactory::getConnection\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        -
            message: '#Class M2Oidc\\OAuth\\Model\\Cache\\RedisConnectionFactory does not have a constructor and must be instantiated without any parameters\.#'
            identifier: new.noConstructor
            reportUnmatched: false
        # Same FactoryAutoloader problem for WebauthnCeremonyFactory: it is a factory
        # for webauthn-lib ceremony objects (serializer, RP entity, ceremony step
        # managers), not a Magento DI factory, but its name matches #Factory$# so the
        # generated create()-only stub shadows the real class's actual methods.
        -
            message: '#Call to an undefined method M2Oidc\\OAuth\\Model\\Passkey\\WebauthnCeremonyFactory::\w+\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        # The same FactoryAutoloader mismatch, one level deeper: WebauthnCeremonyFactory
        # itself instantiates two REAL webauthn-lib classes whose names also happen to
        # end in "Factory" — Webauthn\Denormalizer\WebauthnSerializerFactory and
        # Webauthn\CeremonyStep\CeremonyStepManagerFactory — so bitexpert's
        # FactoryAutoloader shadows their real constructors/methods with its generated
        # create()-only stub the same way. Unlike the Magento-native classes above, a
        # phpstan-stubs.stub override doesn't work here: PHPStan's own stub-file
        # validation pass rejects it as a "class.notFound (non-ignorable)" error, because
        # the very same Extension(Interface)Autoloader misfire that
        # Model/Passkey/PasskeyAuthenticationService.php is excluded from above also
        # trips during that stricter validation for these two classes' real parameter/
        # return types (AttestationStatementSupportManager, SerializerInterface,
        # CeremonyStepManager). ignoreErrors is the only working suppression here.
        -
            message: '#Class Webauthn\\Denormalizer\\WebauthnSerializerFactory does not have a constructor and must be instantiated without any parameters\.#'
            identifier: new.noConstructor
            reportUnmatched: false
        -
            message: '#Property M2Oidc\\OAuth\\Model\\Passkey\\WebauthnCeremonyFactory::\$serializer \(Symfony\\Component\\Serializer\\SerializerInterface\|null\) does not accept Webauthn\\Denormalizer\\WebauthnSerializer\.#'
            identifier: assign.propertyType
            reportUnmatched: false
        -
            message: '#Call to an undefined method Webauthn\\CeremonyStep\\CeremonyStepManagerFactory::(creationCeremony|requestCeremony|setAllowedOrigins)\(\)\.#'
            identifier: method.notFound
            reportUnmatched: false
        # Cm_Cache_Backend_Redis (colinmollenhour/cache-backend-redis) is an intentionally
        # optional runtime dependency for SlidingWindowStrategy's Redis-only fast path —
        # guarded by instanceof + try/catch with graceful degradation, not required by
        # this module's composer.json, so PHPStan can't resolve it in this analysis run.
        -
            message: '#Class Cm_Cache_Backend_Redis not found\.#'
            identifier: class.notFound
            reportUnmatched: false
