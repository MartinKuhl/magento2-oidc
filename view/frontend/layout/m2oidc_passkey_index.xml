<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <arguments>
                <argument name="title" translate="true" xsi:type="string">Passkeys</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="M2Oidc\OAuth\Block\Passkey\ManagePasskeys"
                name="m2oidc.passkey.manage"
                template="passkey/manage.phtml"
                cacheable="false"/>
        </referenceContainer>
    </body>
</page>
